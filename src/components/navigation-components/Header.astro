---
<div class="header-container">
  <h1><a href="/">蓼食う本の虫制作室</a></h1>
  <a href="https://forms.gle/c7Ls3MysYAQVouBQ7" target="_blank" rel="noopener noreferrer" class="contact-button">
    <span class="contact-icon">✉️</span>
    <span class="contact-text">お問い合わせ</span>
  </a>
</div>

<style>
    .header-container {
        border-top:  20px #DAFF0B solid;
        margin-top: 0;
        padding: 16px 40px;
        width: 100%;
        display: flex;
        justify-content: space-between;
        align-items: center;
        box-sizing: border-box;
    }

    h1 {
        color: #DAFF0B;
        -webkit-text-stroke:1.4px black;
        font-weight: normal;
        background-color: #DAFF0B;
        display: inline-block;
        padding: 8px 16px;
        margin: 0;
        animation: floating-y 1.8s ease-in-out infinite alternate-reverse;
    }
    
    @keyframes floating-y {
        0% {
            transform: translateY(-5%);
        }
        100% {
            transform: translateY(5%);
        }
    }

    h1 a {
        text-decoration: none;
        color: #DAFF0B;
    }

    .contact-button {
        color: black;
        text-decoration: none;
        font-weight: 800;
        font-size: 1.1rem;
        white-space: nowrap;
        display: flex;
        align-items: center;
        gap: 8px;
        cursor: pointer;
    }

    .contact-icon {
        font-size: 1.2rem;
        display: inline-block;
        transition: transform 0.2s ease;
        line-height: 1;
        vertical-align: middle;
    }

    .contact-button:hover .contact-icon {
        transform: scale(1.1);
    }

    .contact-text {
        text-decoration: underline;
        text-underline-offset: 4px;
        line-height: 1.2;
        vertical-align: middle;
    }

    @media screen and (max-width: 768px) {
        .header-container {
            padding: 16px;
            flex-direction: column;
            gap: 16px;
        }

        h1 {
            font-size: 2.5rem;
        }

        .contact-button {
            font-size: 1.1rem;
        }

        .contact-icon {
            font-size: 1.3rem;
        }
    }

</style>