---
const allPosts = await Astro.glob('/src/pages/posts/*.md');

const sortedPosts = allPosts.sort((a, b) => {
  const dateA = new Date(a.frontmatter.pubDate || 0);
  const dateB = new Date(b.frontmatter.pubDate || 0);
  return dateB.getTime() - dateA.getTime();
});
---

<div class="posts-container">
  <h2>ブログ記事<span class="section-label">POSTS</span></h2>
  <div class="posts-list">
    {sortedPosts.map((post) => (
      <article class="post-item">
        <a href={post.url}>
          <h3 class="post-item-title">{post.frontmatter.title}</h3>
          <div class="post-item-meta">
            {post.frontmatter.pubDate && (
              <span class="post-item-date">
                {new Date(post.frontmatter.pubDate).toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' })}
              </span>
            )}
            {post.frontmatter.author && (
              <span class="post-item-author">
                {post.frontmatter.author}
              </span>
            )}
          </div>
          {post.frontmatter.description && (
            <p class="post-item-description">{post.frontmatter.description}</p>
          )}
          {post.frontmatter.tags && post.frontmatter.tags.length > 0 && (
            <div class="post-item-tags">
              {post.frontmatter.tags.map((tag) => (
                <span class="post-item-tag">{tag}</span>
              ))}
            </div>
          )}
        </a>
      </article>
    ))}
  </div>
</div>

<style>
  .posts-container {
    max-width: var(--width-content);
    margin: 80px auto;
    padding: 0 16px;
  }

  .posts-container h2 {
    text-align: center;
    font-size: 2rem;
    font-weight: bold;
    margin-bottom: 48px;
    letter-spacing: 0.05em;
  }

  .section-label {
    display: block;
    font-size: 0.45em;
    font-weight: normal;
    color: var(--color-text-muted);
    letter-spacing: 0.2em;
    margin-top: 8px;
  }

  .posts-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 24px;
    margin-top: 40px;
  }

  .post-item {
    background-color: var(--color-white);
    border: 2px solid var(--color-black);
    padding: 24px;
  }

  .post-item a {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .post-item a:hover .post-item-title {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .post-item a:focus-visible {
    outline: 2px solid var(--color-black);
    outline-offset: 4px;
  }

  .post-item-title {
    font-size: 1.3em;
    font-weight: bold;
    margin-bottom: 12px;
    letter-spacing: 0.05em;
    line-height: 1.4;
  }

  .post-item-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-bottom: 16px;
  }

  .post-item-description {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-text-body);
    margin-bottom: 16px;
  }

  .post-item-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
  }

  .post-item-tag {
    background-color: var(--color-white);
    color: var(--color-black);
    padding: 4px 12px;
    font-size: 0.8rem;
    font-weight: bold;
    border: 2px solid var(--color-black);
  }

  @media screen and (max-width: 768px) {
    .posts-container {
      margin: 60px auto;
    }

    .posts-container h2 {
      font-size: 1.6rem;
    }

    .posts-list {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .post-item {
      padding: 20px;
    }
  }
</style>
