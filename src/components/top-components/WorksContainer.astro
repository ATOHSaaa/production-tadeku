---
import { Image } from 'astro:assets';
import TadekuImage from '../../assets/tadeku.png';
import TenkaishaImage from '../../assets/tenkaisha.png';
import CatImage from '../../assets/cat-in-the-park.png';
---

<div class="works-container">
  <h2>制作実績<br /><span>WORKS</span></h2>
  <div class="works-list">
    <div class="works-list-item">
      <a href="https://tadeku.net/" target="_blank" rel="noopener noreferrer">
        <Image src={TadekuImage} alt="蓼食う本の虫Webサイトのスクリーンショット" />
      </a>
      <p class="works-list-item-title">蓼食う本の虫</p>
      <p class="works-list-item-category">Webサイト / 記事制作 / SNS運用</p>
    </div>
    <div class="works-list-item">
      <a href="https://tenkai.org" target="_blank" rel="noopener noreferrer">
        <Image src={TenkaishaImage} alt="転回社Webサイトのスクリーンショット" />
      </a>
      <p class="works-list-item-title">一般社団法人転回社</p>
      <p class="works-list-item-category">Webサイト / 写真 / 広報 / チラシ</p>
    </div>
    <div class="works-list-item">
      <a href="https://atohs.me/cat-in-the-park" target="_blank" rel="noopener noreferrer">
        <Image src={CatImage} alt="Cat in the park. のWebサイトのスクリーンショット" />
      </a>
      <p class="works-list-item-title">Cat in the Park.</p>
      <p class="works-list-item-category">動画 / 写真 / Webサイト</p>
    </div>
  </div>
</div>

<style>
  .works-container {
    max-width: var(--width-content);
    margin: 80px auto;
    padding: 0 16px;
  }

  .works-container h2 {
    text-align: center;
    font-size: 2.5em;
  }

  .works-container h2 span {
    color: white;
    -webkit-text-stroke: white 2px;
    font-size: 0.9em;
    letter-spacing: 2px;
  }

  .works-list {
    max-width: var(--width-content);
    display: flex;
    flex-wrap: wrap;
    margin: 0 auto;
    justify-content: space-between;
  }

  .works-list-item {
    width: 30%;
    margin-bottom: 60px;
  }

  .works-list-item a:focus-visible {
    outline: 3px solid var(--color-brand-lime);
    outline-offset: 4px;
    border-radius: 8px;
    display: block;
  }

  .works-list-item img {
    height: 200px;
    width: 100%;
    object-fit: cover;
    border-radius: 8px;
  }

  .works-list-item-title {
    font-size: 1.2em;
    margin-top: 8px;
  }

  .works-list-item-category {
    font-size: 0.9em;
    color: gray;
    margin-top: 4px;
  }

  @media screen and (max-width: 768px) {
    .works-list {
      justify-content: center;
    }

    .works-list-item {
      width: 90%;
      margin-bottom: 36px;
    }
  }
</style>
