---
import { Image } from 'astro:assets';
import TadekuImage from '../../assets/tadeku.png';
import TenkaishaImage from '../../assets/tenkaisha.png';
import CatImage from '../../assets/cat-in-the-park.png';
---

<div class="works-container">
		<h2>制作実績<br /><span>WORKS</span></h2>
		<div class="works-list">
            <div class="works-list-item">
                <a href="https://tadeku.net/" target="_blank">
                    <Image src={TadekuImage} alt="蓼食う本の虫Webサイトのスクリーンショット" />
                </a>
                <p class="works-list-item-title">蓼食う本の虫</p>
                <p class="works-list-item-category">Webサイト / 記事制作 / SNS運用</p>
            </div>
            <div class="works-list-item">
                <a href="https://tenkai.org" target="_blank">
                    <Image src={TenkaishaImage} alt="転回社Webサイトのスクリーンショット" />
                </a>
                <p class="works-list-item-title">一般社団法人転回社</p>
                <p class="works-list-item-category">Webサイト / 写真 / 広報 / チラシ</p>
            </div>
            <div class="works-list-item">
                <a href="https://atohs.me/cat-in-the-park" target="_blank">
                    <Image src={CatImage} alt="Cat in the park. のWebサイトのスクリーンショット" />
                </a>
                <p class="works-list-item-title">Cat in the Park.</p>
                <p class="works-list-item-category">動画 / 写真 / Webサイト</p>
            </div>
		</div>
	</div>