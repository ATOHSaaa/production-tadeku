---
import { Image } from 'astro:assets';
import TadekuImage from '../../assets/tadeku.png';
import TenkaishaImage from '../../assets/tenkaisha.png';
import CatImage from '../../assets/cat-in-the-park.png';
---

<div class="works-container">
  <h2>制作実績<span class="section-label">WORKS</span></h2>
  <div class="works-list">
    <div class="works-list-item">
      <a href="https://tadeku.net/" target="_blank" rel="noopener noreferrer">
        <Image src={TadekuImage} alt="蓼食う本の虫Webサイトのスクリーンショット" />
      </a>
      <p class="works-list-item-title">蓼食う本の虫</p>
      <p class="works-list-item-category">Webサイト / 記事制作 / SNS運用</p>
    </div>
    <div class="works-list-item">
      <a href="https://tenkai.org" target="_blank" rel="noopener noreferrer">
        <Image src={TenkaishaImage} alt="転回社Webサイトのスクリーンショット" />
      </a>
      <p class="works-list-item-title">一般社団法人転回社</p>
      <p class="works-list-item-category">Webサイト / 写真 / 広報 / チラシ</p>
    </div>
    <div class="works-list-item">
      <a href="https://atohs.me/cat-in-the-park" target="_blank" rel="noopener noreferrer">
        <Image src={CatImage} alt="Cat in the park. のWebサイトのスクリーンショット" />
      </a>
      <p class="works-list-item-title">Cat in the Park.</p>
      <p class="works-list-item-category">動画 / 写真 / Webサイト</p>
    </div>
  </div>
</div>

<style>
  .works-container {
    max-width: var(--width-content);
    margin: 80px auto;
    padding: 0 var(--space-gutter-lg);
  }

  .works-container h2 {
    text-align: center;
    font-size: 2rem;
    font-weight: bold;
    letter-spacing: 0.05em;
    margin-bottom: 48px;
  }

  .section-label {
    display: block;
    font-size: 0.45em;
    font-weight: normal;
    color: var(--color-text-muted);
    letter-spacing: 0.2em;
    margin-top: 8px;
  }

  .works-list {
    max-width: var(--width-content);
    display: flex;
    flex-wrap: wrap;
    margin: 0 auto;
    justify-content: space-between;
  }

  .works-list-item {
    width: 30%;
    margin-bottom: 48px;
  }

  .works-list-item a:focus-visible {
    outline: 2px solid var(--color-black);
    outline-offset: 4px;
    display: block;
  }

  .works-list-item img {
    height: 200px;
    width: 100%;
    object-fit: cover;
    border: 2px solid var(--color-black);
  }

  .works-list-item-title {
    font-size: 1.1em;
    font-weight: bold;
    margin-top: 12px;
  }

  .works-list-item-category {
    font-size: 0.85em;
    color: var(--color-text-muted);
    margin-top: 4px;
  }

  @media screen and (max-width: 768px) {
    .works-container {
      margin: 60px auto;
      padding: 0 var(--space-gutter);
    }

    .works-container h2 {
      font-size: 1.6rem;
      margin-bottom: 32px;
    }

    .works-list {
      flex-direction: column;
      justify-content: flex-start;
    }

    .works-list-item {
      width: 100%;
      margin-bottom: 36px;
    }

    .works-list-item:last-child {
      margin-bottom: 0;
    }
  }
</style>
