---
interface Props {
  limit?: number;
  showViewAll?: boolean;
}

const { limit, showViewAll = false } = Astro.props;

const allPosts = await Astro.glob('/src/pages/blog/*.md');

const sortedPosts = allPosts
  .sort((a, b) => {
    const dateA = new Date(a.frontmatter.pubDate || 0);
    const dateB = new Date(b.frontmatter.pubDate || 0);
    return dateB.getTime() - dateA.getTime();
  })
  .slice(0, limit);
---

<div class="blog-posts">
  <h2 class="blog-posts-heading">
    制作日誌<span class="section-label">BLOG</span>
  </h2>
  <div class="blog-posts-list">
    {sortedPosts.map((post) => (
      <article class="blog-post-item">
        <a href={post.url}>
          <h3 class="blog-post-item-title">{post.frontmatter.title}</h3>
          <div class="blog-post-item-meta">
            {post.frontmatter.pubDate && (
              <span class="blog-post-item-date">
                {new Date(post.frontmatter.pubDate).toLocaleDateString('ja-JP', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })}
              </span>
            )}
            {post.frontmatter.author && (
              <span class="blog-post-item-author">{post.frontmatter.author}</span>
            )}
          </div>
          {post.frontmatter.description && (
            <p class="blog-post-item-description">{post.frontmatter.description}</p>
          )}
          {post.frontmatter.tags && post.frontmatter.tags.length > 0 && (
            <div class="blog-post-item-tags">
              {post.frontmatter.tags.map((tag) => (
                <span class="blog-post-item-tag">{tag}</span>
              ))}
            </div>
          )}
        </a>
      </article>
    ))}
  </div>
  {showViewAll && (
    <div class="blog-posts-footer">
      <a href="/blog" class="blog-posts-view-all">一覧を見る →</a>
    </div>
  )}
</div>

<style>
  .blog-posts {
    max-width: var(--width-content);
    margin: 80px auto;
    padding: 0 var(--space-gutter-lg);
  }

  .blog-posts-heading {
    text-align: center;
    font-size: 2rem;
    font-weight: bold;
    margin-bottom: 48px;
    letter-spacing: 0.05em;
  }

  .section-label {
    display: block;
    font-size: 0.45em;
    font-weight: normal;
    color: var(--color-text-muted);
    letter-spacing: 0.2em;
    margin-top: 8px;
  }

  .blog-posts-list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .blog-post-item {
    background-color: var(--color-white);
    border: 2px solid var(--color-black);
    padding: 24px;
  }

  .blog-post-item a {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .blog-post-item a:hover .blog-post-item-title {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .blog-post-item a:focus-visible {
    outline: 2px solid var(--color-black);
    outline-offset: 4px;
  }

  .blog-post-item-title {
    font-size: 1.2em;
    font-weight: bold;
    margin-bottom: 12px;
    letter-spacing: 0.05em;
    line-height: 1.4;
  }

  .blog-post-item-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-bottom: 16px;
  }

  .blog-post-item-description {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-text-body);
    margin-bottom: 16px;
  }

  .blog-post-item-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
  }

  .blog-post-item-tag {
    background-color: var(--color-white);
    color: var(--color-black);
    padding: 4px 12px;
    font-size: 0.8rem;
    font-weight: bold;
    border: 2px solid var(--color-black);
  }

  .blog-posts-footer {
    margin-top: 40px;
    text-align: center;
  }

  .blog-posts-view-all {
    display: inline-block;
    border: 2px solid var(--color-black);
    padding: 14px 32px;
    font-weight: bold;
    text-decoration: none;
    color: var(--color-white);
    background-color: var(--color-black);
    letter-spacing: 0.05em;
  }

  .blog-posts-view-all:hover {
    background-color: var(--color-white);
    color: var(--color-black);
  }

  .blog-posts-view-all:focus-visible {
    outline: 2px solid var(--color-black);
    outline-offset: 4px;
  }

  @media screen and (max-width: 900px) {
    .blog-posts-list {
      grid-template-columns: 1fr;
    }
  }

  @media screen and (max-width: 768px) {
    .blog-posts {
      margin: 60px auto;
      padding: 0 var(--space-gutter);
    }

    .blog-posts-heading {
      font-size: 1.6rem;
      margin-bottom: 32px;
    }

    .blog-post-item {
      padding: 20px;
    }
  }
</style>
