<div class="page-container">
  <slot />
</div>

<style>
  .page-container {
    padding: 24px 40px;
    max-width: var(--width-content);
    margin: 0 auto;
  }

  .page-container h1 {
    letter-spacing: 0.05em;
    font-weight: bold;
    padding-bottom: 16px;
    border-bottom: 2px solid var(--color-black);
    margin-bottom: 32px;
  }

  .page-container h2 {
    font-size: 1.4rem;
    font-weight: bold;
    letter-spacing: 0.05em;
    border-left: 4px solid var(--color-black);
    padding-left: 16px;
    margin-top: 48px;
    margin-bottom: 16px;
  }

  .page-container :global(p) {
    margin-bottom: 32px;
    line-height: 1.8em;
  }

  .page-container :global(li) {
    margin-bottom: 8px;
    line-height: 1.8em;
  }

  @media screen and (max-width: 768px) {
    .page-container {
      padding: 24px 16px;
    }
  }
</style>
